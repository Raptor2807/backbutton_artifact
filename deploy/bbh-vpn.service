[Unit]
Description=BBH vantage-point OpenVPN tunnel
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
# Point this at the PATCHED .ovpn (must contain the the institution static routes).
ExecStartPre=/opt/bbh/scripts/setup_base_routes.sh
ExecStart=/usr/sbin/openvpn --config /etc/openvpn/vantage.ovpn
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
